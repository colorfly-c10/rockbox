#
# Disable Status Bar
%wd
#
# Load Backdrop
%X(/.rockbox/wps/cabbiev2/wpsbackdrop-400x360x16.bmp)
#
# Preload Images
%xl(A,/.rockbox/wps/cabbiev2/lock-400x360x16.bmp,0,0,2)
%xl(B,/.rockbox/wps/cabbiev2/battery-400x360x16.bmp,0,0,10)
%xl(C,/.rockbox/wps/cabbiev2/volume-400x360x16.bmp,0,0,10)
%xl(D,/.rockbox/wps/cabbiev2/shuffle-400x360x16.bmp,0,0)
%xl(E,/.rockbox/wps/cabbiev2/repeat-400x360x16.bmp,0,0,4)
%xl(F,/.rockbox/wps/cabbiev2/playmode-400x360x16.bmp,0,0,5)
#
# Album Art/Info Viewport Conditional
%?C<%Vd(a)|%Vd(b)>
#
# Progress Bar
%V(10,243,380,22,-)
%pb(0,0,380,22,/.rockbox/wps/cabbiev2/pb-400x360x16.bmp)
#
# Hold
%V(144,310,30,34,-)
%?mh<%xd(Aa)|%xd(Ab)>
#
# Battery
%V(182,310,44,34,-)
%?bp<%?bc<%xd(Ba)|%xd(Bb)>|%?bl<|%xd(Bc)|%xd(Bd)|%xd(Be)|%xd(Bf)|%xd(Bg)|%xd(Bh)|%xd(Bi)|%xd(Bj)>>
#
# Volume
%V(233,310,34,34,-)
%?pv<%xd(Ca)|%xd(Cb)|%xd(Cc)|%xd(Cd)|%xd(Ce)|%xd(Cf)|%xd(Cg)|%xd(Ch)|%xd(Ci)|%xd(Cj)>
#
# Shuffle
%V(277,316,37,24,-)
%?ps<%xd(D)>
#
# Repeat
%V(320,310,18,34,-)
%?mm<|%xd(Ea)|%xd(Eb)|%xd(Ec)|%xd(Ed)>
#
# Playmode
%V(346,310,24,34,-)
%?mp<%xd(Fa)|%xd(Fb)|%xd(Fc)|%xd(Fd)|%xd(Fe)>
#
# Time Elapsed/Remaining
%V(32,270,336,30,1)
%al%pc%ac%?Sr<%pe %Sx(of) %pp|%pp %Sx(of) %pe>%ar%pr
#
# Album Art
%ax%Vl(a,16,48,120,180,-)
%Cl(0,0,120,180,c,c)
%Cd
#
# Track Info - Album Art
%ax%Vl(a,153,48,-,183,1)
%s%al%?id<%id|%?d(1)<%d(1)|%(root%)>>
%s%al%?it<%it|%fn>
%s%al%?ia<%ia|%?iA<%iA|%?d(2)<%d(2)|%(root%)>>>
%s%al%?iy<%iy>

%s%al%Sx(Next Track:)
%s%al%?It<%It|%Fn>
%s%al%?Ia<%Ia|%?IA<%IA>>
#
# Track Info - No Album Art
%ax%Vl(b,0,48,-,183,1)
%s%ac%?id<%id|%?d(1)<%d(1)|%(root%)>>
%s%ac%?it<%it|%fn>
%s%ac%?ia<%ia|%?iA<%iA|%?d(2)<%d(2)|%(root%)>>>
%s%ac%?iy<%iy>

%ac%Sx(Next Track:)
%s%ac%?It<%It|%Fn>
%s%ac%?Ia<%Ia|%?IA<%IA>>
